# ==============================================================================
# TiniWish Environment Variables Template
# Copy this file to .env or .env.local for local development.
# DO NOT commit real secrets or credentials into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & HOSTING
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="TiniWish"

# ------------------------------------------------------------------------------
# 2. SUPABASE & POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# Supabase transaction pooler URL (PgBouncer mode, port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL for Prisma migrations (Direct port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Public API & Authentication
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here"

# ------------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY (INDIA)
# ------------------------------------------------------------------------------
# Razorpay Test / Live Key ID (Safe for frontend)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholderKeyId"

# Razorpay Secret Key (Server-only)
RAZORPAY_KEY_SECRET="placeholderSecretKeyForRazorpay"

# Razorpay Webhook Secret for HMAC-SHA256 signature verification
RAZORPAY_WEBHOOK_SECRET="placeholderWebhookSecret"

# ------------------------------------------------------------------------------
# 4. SHIPROCKET LOGISTICS & FULFILLMENT
# ------------------------------------------------------------------------------
# Shiprocket API authentication credentials
SHIPROCKET_EMAIL="logistics@tiniwish.com"
SHIPROCKET_PASSWORD="placeholderShiprocketPassword"
SHIPROCKET_WEBHOOK_SECRET="placeholderShiprocketWebhookToken"

# ------------------------------------------------------------------------------
# 5. CLOUDFLARE R2 (OBJECT STORAGE)
# ------------------------------------------------------------------------------
# Cloudflare R2 S3-compatible credentials for product images & assets
R2_ACCOUNT_ID="placeholder_cloudflare_account_id"
R2_ACCESS_KEY_ID="placeholder_r2_access_key_id"
R2_SECRET_ACCESS_KEY="placeholder_r2_secret_access_key"
R2_BUCKET_NAME="tiniwish-assets"
NEXT_PUBLIC_R2_PUBLIC_URL="https://assets.tiniwish.com"

# ------------------------------------------------------------------------------
# 6. RESEND TRANSACTIONAL EMAILS
# ------------------------------------------------------------------------------
# Resend API Key for order confirmations and tracking alerts
RESEND_API_KEY="re_placeholder_resend_api_key"
RESEND_FROM_EMAIL="orders@tiniwish.com"

